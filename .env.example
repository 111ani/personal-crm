# Copy to .env and fill in the values. Never commit .env

# PostgreSQL in Docker (see docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Account that receives the existing contacts and groups and owns demo data
CRM_OWNER_EMAIL=

# Sign-in links and session cookies
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Mailpit locally, Resend SMTP in production
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
